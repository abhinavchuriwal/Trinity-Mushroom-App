<% var title = 'Raw Materials' %>
<%- include('partials/header') %>

<h1>Settings</h1>
<%- include('partials/settings-nav') %>

<h2 style="margin-bottom:0.4rem">Raw Materials Master List</h2>
<p class="muted">Fix a default cost per kg (NPR) and dry-basis Carbon % / Nitrogen % / Moisture % for each material you use. <strong>Used in</strong> decides which recipe offers it &mdash; the compost mix on New Batch, the casing mix on the Casing page, or both. Casing materials (cocopeat, ball clay, calcium carbonate) only need a cost per kg; carbon and nitrogen don't apply to them. These become the dropdown choices &amp; defaults when building a batch's raw material recipe on the New Batch page &mdash; cost, C%, N%, and moisture % can all still be overridden per batch if a specific delivery differs. Moisture matters even without a lab reading: the C:N ratio is calculated from dry matter, and different materials (fresh manure vs. air-dried straw) hold very different amounts of water. Editing or deactivating a material here never changes figures already recorded on past batches.</p>

<% if (error) { %>
  <p style="color:#c0392b; font-weight:600"><%= error %></p>
<% } %>

<% if (can('manage_raw_materials')) { %>
<div class="card">
  <h2>Add Raw Material</h2>
  <form class="grid" method="post" action="/raw-materials">
    <div class="field"><label>Name</label><input type="text" name="name" placeholder="e.g. Paddy Straw" required /></div>
    <div class="field">
      <label>Used in</label>
      <select name="category">
        <option value="compost">Compost mix</option>
        <option value="casing">Casing mix</option>
        <option value="both">Both</option>
      </select>
    </div>
    <div class="field"><label>Landed Cost (NPR/kg)</label><input type="number" step="any" name="default_cost_per_kg_npr" /></div>
    <div class="field"><label>Standard Carbon %</label><input type="number" step="any" name="carbon_pct" /></div>
    <div class="field"><label>Standard Nitrogen %</label><input type="number" step="any" name="nitrogen_pct" /></div>
    <div class="field"><label>Standard Moisture %</label><input type="number" step="any" name="moisture_pct" /></div>
    <div class="field"><label>Standard Ash % (dry basis)</label><input type="number" step="any" name="ash_pct" /></div>
    <div class="field wide"><label>Notes</label><input type="text" name="notes" /></div>
    <div class="form-actions"><button class="btn" type="submit">Add Material</button></div>
  </form>
</div>
<% } %>

<div class="card">
  <h2>Materials</h2>
  <% if (saved) { %><div class="saved-notice" style="margin-bottom:0.8rem">&#10003; Saved.</div><% } %>
  <% if (materials.length === 0) { %>
    <div class="empty-state">No raw materials yet. Add your first one above.</div>
  <% } else { %>
    <% var ro = !can('manage_raw_materials') %>
    <%# Delete forms live outside the table so they never nest inside the one
        big Save form; each row's button points at its own by id. %>
    <% if (!ro) { %>
      <form id="mat-bulk" method="post" action="/raw-materials/bulk"></form>
      <% materials.forEach(function(m) { %>
        <form id="mat-del-<%= m.id %>" method="post" action="/raw-materials/<%= m.id %>/delete"
          data-confirm="Delete <%= m.name %>? Past batches keep their recorded costs regardless."></form>
      <% }) %>
    <% } %>
    <p class="muted" style="margin-top:0">Change as many rows as you like, then press <strong>Save all materials</strong> once at the bottom.</p>
    <div class="table-scroll">
    <table class="settings-table">
      <thead>
        <tr>
          <th>Name</th><th>Used in</th><th>On new batches</th><th>Landed Cost (NPR/kg)</th><th>Standard Carbon %</th><th>Standard Nitrogen %</th>
          <th>C:N of Material</th><th>Standard Moisture %</th><th>Standard Ash %</th><th>Notes</th><th>Active</th>
          <% if (!ro) { %><th>Delete</th><% } %>
        </tr>
      </thead>
      <tbody>
        <% materials.forEach(function(m) { %>
          <tr style="<%= m.active ? '' : 'opacity:0.5' %>">
            <td>
              <input form="mat-bulk" type="hidden" name="id" value="<%= m.id %>" />
              <input form="mat-bulk" type="text" name="name_<%= m.id %>" value="<%= m.name %>" style="width:11rem" required <%= ro ? 'disabled' : '' %> />
            </td>
            <td>
              <select form="mat-bulk" name="category_<%= m.id %>" style="width:7rem" <%= ro ? 'disabled' : '' %>>
                <% ['compost','casing','both'].forEach(function(c) { %>
                  <option value="<%= c %>" <%= (m.category || 'compost') === c ? 'selected' : '' %>><%= { compost: 'Compost mix', casing: 'Casing mix', both: 'Both' }[c] %></option>
                <% }) %>
              </select>
            </td>
            <td><input form="mat-bulk" type="checkbox" name="is_default_<%= m.id %>" value="1" <%= m.is_default ? 'checked' : '' %> style="width:auto" <%= ro ? 'disabled' : '' %> /></td>
            <td><input form="mat-bulk" type="number" step="any" name="default_cost_per_kg_npr_<%= m.id %>" value="<%= m.default_cost_per_kg_npr === null ? '' : m.default_cost_per_kg_npr %>" style="width:6rem" <%= ro ? 'disabled' : '' %> /></td>
            <td><input form="mat-bulk" type="number" step="any" name="carbon_pct_<%= m.id %>" value="<%= m.carbon_pct === null ? '' : m.carbon_pct %>" style="width:5rem" <%= ro ? 'disabled' : '' %> /></td>
            <td><input form="mat-bulk" type="number" step="any" name="nitrogen_pct_<%= m.id %>" value="<%= m.nitrogen_pct === null ? '' : m.nitrogen_pct %>" style="width:5rem" <%= ro ? 'disabled' : '' %> /></td>
            <td class="muted"><%= (m.carbon_pct && m.nitrogen_pct) ? (m.carbon_pct / m.nitrogen_pct).toFixed(1) + ':1' : '—' %></td>
            <td><input form="mat-bulk" type="number" step="any" name="moisture_pct_<%= m.id %>" value="<%= m.moisture_pct === null ? '' : m.moisture_pct %>" style="width:5rem" <%= ro ? 'disabled' : '' %> /></td>
            <td><input form="mat-bulk" type="number" step="any" name="ash_pct_<%= m.id %>" value="<%= m.ash_pct === null ? '' : m.ash_pct %>" style="width:5rem" <%= ro ? 'disabled' : '' %> /></td>
            <td><input form="mat-bulk" type="text" name="notes_<%= m.id %>" value="<%= m.notes || '' %>" style="width:14rem" <%= ro ? 'disabled' : '' %> /></td>
            <td><input form="mat-bulk" type="checkbox" name="active_<%= m.id %>" value="1" <%= m.active ? 'checked' : '' %> style="width:auto" <%= ro ? 'disabled' : '' %> /></td>
            <% if (!ro) { %>
              <td><button form="mat-del-<%= m.id %>" class="btn small danger" type="submit">Del</button></td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% if (!ro) { %>
      <div class="form-actions" style="margin-top:0.9rem"><button form="mat-bulk" class="btn" type="submit">Save all materials</button></div>
    <% } %>
  <% } %>
</div>

<%- include('partials/footer') %>
