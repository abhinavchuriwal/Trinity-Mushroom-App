<% var title = 'Compost Day Sheet' %>
<%- include('partials/header') %>

<%
  // Each section carries its own batch picker, in the order the paper sheet
  // runs, so a filled C-1 is typed straight down the screen.
  function batchPicker(stage, list) {
%>
  <div class="field">
    <label>Batch</label>
    <select name="batch_id" required>
      <option value="">— Select batch —</option>
      <% list.forEach(function (x) { %><option value="<%= x.id %>"><%= x.batch_code %></option><% }) %>
    </select>
  </div>
<%
  }
  function sectionHead(num, label, list) {
%>
  <div class="today-sec">
    <span class="n"><%= num %></span>
    <h2><%= label %></h2>
    <span class="sheet">Sheet C-1 · <%= num %></span>
  </div>
  <% if (!list.length) { %>
    <div class="today-empty">No batch is at this step right now.</div>
  <% } %>
<%
  }
%>

<div class="today-head">
  <h1>Compost Day Sheet</h1>
  <div class="muted">Form C-1 on screen &mdash; <%= today %> &middot; <%= currentFarm.name %></div>
</div>

<% if (saved) { %><div class="saved-notice" style="margin-bottom:1rem">&#10003; <%= saved %></div><% } %>

<div class="qc-legend" style="margin-bottom:1rem">
  Daily bunker and tunnel readings are on <a href="/day/readings"><strong>Daily Readings</strong></a> (Form C-2). This sheet is for the once-per-batch steps.
</div>

<% if (canCreate) { %>
  <div class="today-sec"><span class="n">1</span><h2>New Batch &amp; Recipe</h2><span class="sheet">Sheet C-1 · 1</span></div>
  <section class="card day-row">
    <div class="task-facts">Batch code, start date and the raw material recipe. The recipe needs its own page because it has a line per material.</div>
    <div class="task-actions"><a class="btn" href="/batches/new">Start a new batch</a></div>
  </section>
<% } %>

<% if (mine.includes('prewetting')) { %>
  <% sectionHead(2, 'Pre-Wetting', batches.prewetting) %>
  <% if (batches.prewetting.length) { %>
    <form method="post" action="/day/section/prewetting">
      <section class="card day-row">
        <div class="grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:0.85rem; align-items:end">
          <% batchPicker('prewetting', batches.prewetting) %>
          <div class="field"><label>In date</label><input type="date" name="in_date" value="<%= today %>" /></div>
          <div class="field"><label>Out date</label><input type="date" name="out_date" /></div>
          <div class="field"><label>Entered by</label><input type="text" name="entered_by" value="<%= currentUser.full_name || currentUser.username %>" /></div>
          <div class="field"><label>Notes</label><input type="text" name="notes" /></div>
        </div>
        <div class="form-actions">
          <button class="btn" type="submit">Save Pre-Wetting</button>
          <label class="muted"><input type="checkbox" name="advance" value="1" style="width:auto" /> Complete &amp; move to Phase I</label>
        </div>
      </section>
    </form>
  <% } %>
<% } %>

<% if (mine.includes('phase1')) { %>
  <% sectionHead(3, 'Phase I — Bunker Composting', batches.phase1) %>
  <% if (batches.phase1.length) { %>
    <form method="post" action="/day/section/phase1">
      <section class="card day-row">
        <div class="grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:0.85rem; align-items:end">
          <% batchPicker('phase1', batches.phase1) %>
          <div class="field"><label>Bunker</label><select name="bunker_no"><%- optionsFor(bunkers, null) %></select></div>
          <div class="field"><label>Lab C:N ratio</label><input type="number" step="any" name="end_cn_ratio" inputmode="decimal" /></div>
          <div class="field"><label>Lab nitrogen %</label><input type="number" step="any" name="end_nitrogen_pct" inputmode="decimal" /></div>
          <div class="field"><label>Lab ash %</label><input type="number" step="any" name="end_ash_pct" inputmode="decimal" /></div>
          <div class="field"><label>Notes</label><input type="text" name="notes" /></div>
        </div>
        <div class="form-actions">
          <button class="btn" type="submit">Save Phase I</button>
          <label class="muted"><input type="checkbox" name="advance" value="1" style="width:auto" /> Complete &amp; move to Phase II</label>
        </div>
        <div class="muted" style="font-size:0.8rem">Two batches in one day: save the first, then pick the next batch and save again. Start and end dates fill themselves as the batch moves; turn readings go on Daily Readings.</div>
      </section>
    </form>
  <% } %>
<% } %>

<% if (mine.includes('phase2')) { %>
  <% sectionHead(4, 'Phase II — Tunnel', batches.phase2) %>
  <% if (batches.phase2.length) { %>
    <form method="post" action="/day/section/phase2">
      <section class="card day-row">
        <div class="grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:0.85rem; align-items:end">
          <% batchPicker('phase2', batches.phase2) %>
          <div class="field"><label>Tunnel</label><select name="tunnel_id"><%- optionsFor(tunnels, null) %></select></div>
          <div class="field"><label>Pasteurization date</label><input type="date" name="pasteurization_date" /></div>
          <div class="field">
            <label>Pasteurization temp (&deg;C)</label>
            <input type="number" step="any" name="pasteurization_temp_c" inputmode="decimal" />
            <span class="muted" style="font-size:0.78rem">Target <%= qcParam('phase2','pasteurization_temp_c')?.min_value %>&ndash;<%= qcParam('phase2','pasteurization_temp_c')?.max_value %></span>
          </div>
          <div class="field">
            <label>Pasteurization hours</label>
            <input type="number" step="any" name="pasteurization_duration_hrs" inputmode="decimal" />
            <span class="muted" style="font-size:0.78rem">Target <%= qcParam('phase2','pasteurization_duration_hrs')?.min_value %>&ndash;<%= qcParam('phase2','pasteurization_duration_hrs')?.max_value %></span>
          </div>
          <div class="field"><label>Conditioning start date</label><input type="date" name="conditioning_date" /></div>
          <div class="field">
            <label>Conditioning temp (&deg;C)</label>
            <input type="number" step="any" name="conditioning_temp_c" inputmode="decimal" />
            <span class="muted" style="font-size:0.78rem">Target <%= qcParam('phase2','temp_c')?.min_value %>&ndash;<%= qcParam('phase2','temp_c')?.max_value %></span>
          </div>
          <div class="field"><label>Notes</label><input type="text" name="notes" /></div>
        </div>
        <div class="form-actions">
          <button class="btn" type="submit">Save Phase II</button>
          <label class="muted"><input type="checkbox" name="advance" value="1" style="width:auto" /> Complete &amp; move to Spawning</label>
        </div>
        <div class="muted" style="font-size:0.8rem">Two batches in one day: save the first, then pick the next batch and save again. Fill and end dates fill themselves; day-by-day conditioning readings go on Daily Readings; the lab result is entered at Spawning.</div>
      </section>
    </form>
  <% } %>
<% } %>

<% if (mine.includes('spawning')) { %>
  <% sectionHead(5, 'Spawning', batches.spawning) %>
  <% if (batches.spawning.length) { %>
    <form method="post" action="/day/section/spawning">
      <section class="card day-row">
        <div class="grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:0.85rem; align-items:end">
          <% batchPicker('spawning', batches.spawning) %>
          <div class="field"><label>Spawning date</label><input type="date" name="spawning_date" value="<%= today %>" /></div>
          <div class="field"><label>Spawn strain</label><input type="text" name="spawn_strain" /></div>
          <div class="field">
            <label>Spawn rate (%)</label>
            <input type="number" step="any" name="spawn_rate_pct" inputmode="decimal" />
            <span class="muted" style="font-size:0.78rem">Target <%= qcParam('spawning','spawn_rate_pct')?.min_value %>&ndash;<%= qcParam('spawning','spawn_rate_pct')?.max_value %></span>
          </div>
          <div class="field">
            <label>Spawning method</label>
            <select name="spawning_method"><option value="">—</option><option value="surface">Surface</option><option value="through_mix">Through-mix</option></select>
          </div>
          <div class="field">
            <label>Compost temp (&deg;C)</label>
            <input type="number" step="any" name="compost_temp_c" inputmode="decimal" />
            <span class="muted" style="font-size:0.78rem">Target <%= qcParam('spawning','compost_temp_c')?.min_value %>&ndash;<%= qcParam('spawning','compost_temp_c')?.max_value %></span>
          </div>
          <div class="field"><label>Room</label><select name="room_id"><%- optionsFor(growingRooms, null) %></select></div>
          <div class="field"><label>No. of bags</label><input type="number" name="num_bags" inputmode="numeric" /></div>
          <div class="field"><label>Kg per bag</label><input type="number" step="any" name="kg_per_bag" inputmode="decimal" /></div>
          <div class="field"><label>Entered by</label><input type="text" name="entered_by" value="<%= currentUser.full_name || currentUser.username %>" /></div>
        </div>

        <h3 style="margin-top:1rem">Finished compost — checked as it is spawned</h3>
        <div class="grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:0.85rem; align-items:end">
          <div class="field">
            <label>Lab C:N ratio</label>
            <input type="number" step="any" name="final_cn_ratio" inputmode="decimal" />
            <span class="muted" style="font-size:0.78rem">Target <%= qcParam('phase2','final_cn_ratio')?.min_value %>&ndash;<%= qcParam('phase2','final_cn_ratio')?.max_value %></span>
          </div>
          <div class="field"><label>Lab nitrogen %</label><input type="number" step="any" name="final_nitrogen_pct" inputmode="decimal" /></div>
          <div class="field"><label>Lab ash %</label><input type="number" step="any" name="final_ash_pct" inputmode="decimal" /></div>
          <div class="field">
            <label>Final moisture (%)</label>
            <input type="number" step="any" name="final_moisture_pct" inputmode="decimal" />
            <span class="muted" style="font-size:0.78rem">Target <%= qcParam('phase2','final_moisture_pct')?.min_value %>&ndash;<%= qcParam('phase2','final_moisture_pct')?.max_value %></span>
          </div>
          <div class="field">
            <label>Ammonia cleared?</label>
            <select name="ammonia_cleared"><option value="">—</option><option value="yes">Yes</option><option value="no">No</option></select>
          </div>
          <div class="field"><label>Colour</label><input type="text" name="compost_color" /></div>
          <div class="field"><label>Texture</label><input type="text" name="compost_texture" /></div>
          <div class="field"><label>Smell</label><input type="text" name="compost_smell" /></div>
        </div>

        <div class="form-actions">
          <button class="btn" type="submit">Save Spawning</button>
          <label class="muted"><input type="checkbox" name="advance" value="1" style="width:auto" /> Complete &amp; move on</label>
        </div>
      </section>
    </form>
  <% } %>
<% } %>

<% if (mine.includes('dispatch')) { %>
  <% sectionHead(6, 'Dispatch', batches.dispatch) %>
  <% if (batches.dispatch.length) { %>
    <form method="post" action="/day/section/dispatch">
      <section class="card day-row">
        <div class="grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:0.85rem; align-items:end">
          <% batchPicker('dispatch', batches.dispatch) %>
          <div class="field"><label>Dispatch date</label><input type="date" name="dispatch_date" value="<%= today %>" /></div>
          <div class="field"><label>Quantity (kg)</label><input type="number" step="any" name="qty_kg" inputmode="decimal" required /></div>
          <div class="field">
            <label>Going to</label>
            <select name="destination_type" id="day-dest">
              <option value="internal">Our Growing Unit</option>
              <option value="external">Sold to another farm</option>
            </select>
          </div>
          <div class="field" id="day-buyer" style="display:none"><label>Buyer</label><input type="text" name="buyer_name" /></div>
          <div class="field"><label>Entered by</label><input type="text" name="entered_by" value="<%= currentUser.full_name || currentUser.username %>" /></div>
          <div class="field"><label>Notes</label><input type="text" name="notes" /></div>
        </div>
        <div class="form-actions">
          <button class="btn" type="submit">Record Dispatch</button>
          <label class="muted"><input type="checkbox" name="advance" value="1" style="width:auto" /> Last delivery — close this batch</label>
        </div>
      </section>
    </form>
    <script>
      (function () {
        var sel = document.getElementById('day-dest');
        var buyer = document.getElementById('day-buyer');
        if (!sel || !buyer) return;
        function sync() { buyer.style.display = sel.value === 'external' ? '' : 'none'; }
        sel.addEventListener('change', sync);
        sync();
      })();
    </script>
  <% } %>
<% } %>

<%- include('partials/footer') %>
