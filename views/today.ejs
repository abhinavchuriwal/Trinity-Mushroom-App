<% var title = 'Today' %>
<%- include('partials/header') %>

<%
  function fmt(d, opts) {
    if (!d) return '—';
    return new Intl.DateTimeFormat('en-GB', Object.assign({ timeZone: 'UTC' }, opts)).format(new Date(d + 'T00:00:00Z'));
  }
  var dateLabel = fmt(today, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  function shortDate(d) {
    if (d === today) return 'today';
    return fmt(d, { day: 'numeric', month: 'short' });
  }
  var compostForms = forms.filter(function (f) { return f.dept === 'compost'; });
  var growingForms = forms.filter(function (f) { return f.dept === 'growing'; });
%>

<div class="today-head">
  <h1>Today</h1>
  <div class="muted"><%= dateLabel %> &middot; <%= currentFarm.name %></div>
</div>

<% if (!forms.length) { %>
  <div class="card">
    <div class="empty-state">Your role can look at batches but not enter data, so there is no day sheet for you here. Use <a href="/">Dashboard</a> and <a href="/reports">Reports</a> to see the farm's records.</div>
  </div>
<% } else { %>
  <%
    // One card per paper form. Tapping it opens that form on screen, with the
    // same sections in the same order as the printed sheet.
    function formCard(f) {
  %>
    <a class="form-card" href="<%= f.href %>">
      <div class="form-card-top">
        <span class="form-code">Form <%= f.code %></span>
        <% if (f.done) { %><span class="task-done">&#10003; <%= f.done %></span><% } %>
      </div>
      <div class="form-name"><%= f.name %></div>
      <div class="form-blurb"><%= f.blurb %></div>
      <% if (f.waiting && f.waiting.length) { %>
        <div class="form-waiting">
          <% f.waiting.forEach(function (w, i) { %><%= i ? ' · ' : '' %><strong><%= w.count %></strong> at <%= w.label %><% }) %>
        </div>
      <% } else if (f.waiting) { %>
        <div class="form-waiting muted">No batch is at one of these steps right now</div>
      <% } %>
      <% if (f.note) { %><div class="form-waiting"><%= f.note %></div><% } %>
      <span class="form-open">Open &rarr;</span>
    </a>
  <%
    }
  %>

  <% if (compostForms.length) { %>
    <% if (growingForms.length) { %><h2 class="today-dept">Compost Department</h2><% } %>
    <div class="form-grid"><% compostForms.forEach(formCard) %></div>
  <% } %>

  <% if (growingForms.length) { %>
    <% if (compostForms.length) { %><h2 class="today-dept">Growing Department</h2><% } %>
    <div class="form-grid"><% growingForms.forEach(formCard) %></div>
  <% } %>

  <%# Below the sheets: where each batch stands, so a supervisor can see what is
      running without opening anything. %>
  <h2 class="today-dept">Batches right now</h2>
  <% if (!tasks.length) { %>
    <div class="today-empty">
      Nothing is waiting for you in <strong><%= currentFarm.name %></strong>.
      <% if (allowedFarms.length > 1) { %>Working in a different unit? Open <strong>Menu</strong> and switch the workspace.<% } %>
    </div>
  <% } else { %>
    <div class="task-grid">
      <% tasks.forEach(function (t) { %>
        <section class="task-card">
          <div class="task-top">
            <span class="task-stage"><%= t.stage.label %></span>
            <% if (t.location || t.day) { %>
              <span class="task-where"><%= t.location || '' %><%= t.location && t.day ? ' · ' : '' %><%= t.day ? 'Day ' + t.day : '' %></span>
            <% } %>
          </div>
          <div class="task-title batch-code"><%= t.batch.batch_code %></div>
          <% if (t.kind === 'phase1' || t.kind === 'phase2') { %>
            <div class="task-facts">
              <% if (!t.last) { %>
                No readings yet
              <% } else if (t.kind === 'phase1') { %>
                Last: <%= t.last.turn_number ? 'Turn ' + t.last.turn_number + ', ' : '' %><%= shortDate(t.last.reading_date) %>
                &middot; <%- qcCell('phase1', 'pile_temp_c', t.last.pile_temp_c) %>
              <% } else { %>
                Last: <%= shortDate(t.last.reading_date) %>
                &middot; <%- qcCell('phase2', 'temp_c', t.last.temp_c) %>
                <% if (t.last.ammonia_ppm !== null) { %>&middot; <%- qcCell('phase2', 'ammonia_ppm', t.last.ammonia_ppm) %><% } %>
              <% } %>
            </div>
            <% if (t.loggedToday) { %><div class="task-done">&#10003; Reading logged today</div><% } %>
          <% } %>
          <div class="task-actions">
            <a class="task-secondary" href="<%= t.href %>">Open this batch's <%= t.stage.label %> page</a>
          </div>
        </section>
      <% }) %>
    </div>
  <% } %>
<% } %>

<%- include('partials/footer') %>
