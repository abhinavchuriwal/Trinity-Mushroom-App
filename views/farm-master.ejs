<% var title = 'Farm Master Data' %>
<%- include('partials/header') %>

<h1>Settings</h1>
<%- include('partials/settings-nav') %>

<h2 style="margin-bottom:0.4rem">Farm Master Data</h2>
<p class="muted">The fixed inventory of growing rooms, tunnels, and bunkers on the farm. These codes become the dropdown choices on Phase I (bunker), Phase II (tunnel), Spawning/Casing (room), and Room In (room). Deactivating an entry keeps it visible on batches that already recorded it, it just drops out of the dropdown for new entries.</p>

<% if (error) { %>
  <p style="color:#c0392b; font-weight:600"><%= error %></p>
<% } %>

<% if (saved) { %><div class="saved-notice" style="margin-bottom:1rem">&#10003; Saved.</div><% } %>

<%
  var editable = can('manage_farm_master');
%>
<%# Delete forms and the single Save form sit outside the tables, so nothing
    nests and every row's inputs can point at the one Save. %>
<% if (editable) { %>
  <form id="master-bulk" method="post" action="/farm-master/bulk"></form>
<% } %>

<%
  function masterCard(key, title, basePath, placeholder, rows) {
%>
<div class="card">
  <h2><%= title %></h2>
  <% if (editable) { %>
  <form class="grid" method="post" action="<%= basePath %>">
    <div class="field"><label>Code</label><input type="text" name="code" placeholder="<%= placeholder %>" required /></div>
    <div class="field"><label>Name / Description</label><input type="text" name="name" /></div>
    <div class="field wide"><label>Notes</label><input type="text" name="notes" /></div>
    <div class="form-actions"><button class="btn" type="submit">Add</button></div>
  </form>
  <% } %>

  <% if (!rows.length) { %>
    <div class="empty-state">None added yet.</div>
  <% } else { %>
    <% if (editable) { rows.forEach(function(r) { %>
      <form id="<%= key %>-del-<%= r.id %>" method="post" action="<%= basePath %>/<%= r.id %>/delete"
        data-confirm="Delete <%= r.code %>? Batches that already recorded it keep the value."></form>
    <% }) } %>
    <div class="table-scroll">
    <table class="settings-table">
      <thead><tr><th>Code</th><th>Name / Description</th><th>Notes</th><th>Active</th><% if (editable) { %><th>Delete</th><% } %></tr></thead>
      <tbody>
        <% rows.forEach(function(r) { %>
          <tr style="<%= r.active ? '' : 'opacity:0.5' %>">
            <td>
              <input form="master-bulk" type="hidden" name="id_<%= key %>" value="<%= r.id %>" />
              <input form="master-bulk" type="text" name="code_<%= key %>_<%= r.id %>" value="<%= r.code %>" style="width:6rem" required <%= editable ? '' : 'disabled' %> />
            </td>
            <td><input form="master-bulk" type="text" name="name_<%= key %>_<%= r.id %>" value="<%= r.name || '' %>" style="width:11rem" <%= editable ? '' : 'disabled' %> /></td>
            <td><input form="master-bulk" type="text" name="notes_<%= key %>_<%= r.id %>" value="<%= r.notes || '' %>" style="width:11rem" <%= editable ? '' : 'disabled' %> /></td>
            <td><input form="master-bulk" type="checkbox" name="active_<%= key %>_<%= r.id %>" value="1" <%= r.active ? 'checked' : '' %> style="width:auto" <%= editable ? '' : 'disabled' %> /></td>
            <% if (editable) { %>
              <td><button form="<%= key %>-del-<%= r.id %>" class="btn small danger" type="submit">Del</button></td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
</div>
<%
  }
  masterCard('rooms', 'Growing Rooms', '/farm-master/rooms', 'e.g. GR1', growingRooms);
  masterCard('tunnels', 'Tunnels', '/farm-master/tunnels', 'e.g. T1', tunnels);
  masterCard('bunkers', 'Bunkers', '/farm-master/bunkers', 'e.g. B1', bunkers);
%>

<% if (editable) { %>
  <div class="card">
    <div class="form-actions"><button form="master-bulk" class="btn" type="submit">Save all farm master data</button></div>
    <p class="muted" style="margin:0.5rem 0 0">Change rooms, tunnels and bunkers together, then save once. Adding or deleting an entry still takes effect on its own.</p>
  </div>
<% } %>

<%- include('partials/footer') %>
