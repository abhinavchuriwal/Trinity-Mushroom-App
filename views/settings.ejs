<% var title = 'Settings' %>
<%- include('partials/header') %>

<h1>Settings</h1>
<%- include('partials/settings-nav') %>

<p class="muted">These ranges drive the OK / LOW / HIGH flags shown on batch pages. The defaults are typical starting points for button mushroom compost and casing &mdash; calibrate them to your own SOP. Change as many as you like, then save once at the bottom.</p>

<% if (saved) { %><div class="saved-notice" style="margin-bottom:1rem">&#10003; Saved.</div><% } %>
<% if (can('manage_qc_settings')) { %><form id="qc-bulk" method="post" action="/settings/qc-parameters"></form><% } %>

<%
  // One card per stage, in process order, so the casing ranges sit on their own
  // rather than at the end of one long list of compost parameters.
  var stageLabels = {
    intake: 'Pre-Wetting — Recipe',
    phase1: 'Phase I — Bunker Composting',
    phase2: 'Phase II — Tunnel',
    spawning: 'Spawning',
    casing: 'Casing',
  };
  var stageNotes = {
    intake: 'Calculated from the raw material recipe on dry matter.',
    phase1: 'Taken before each turn, and the lab result at the end of Phase I.',
    phase2: 'Conditioning readings in the tunnel; the finished-compost lab result is entered at Spawning.',
    spawning: 'Checked on the compost as it is spawned.',
    casing: 'The casing soil mix and the layer applied in the room.',
  };
  var byStage = {};
  params.forEach(function (p) {
    (byStage[p.stage] = byStage[p.stage] || []).push(p);
  });
  var stageOrder = Object.keys(stageLabels).filter(function (s) { return byStage[s]; })
    .concat(Object.keys(byStage).filter(function (s) { return !stageLabels[s]; }));
%>

<% stageOrder.forEach(function (stage) { %>
  <div class="card">
    <h2><%= stageLabels[stage] || stage %></h2>
    <% if (stageNotes[stage]) { %><p class="muted"><%= stageNotes[stage] %></p><% } %>
    <div class="table-scroll">
      <table class="settings-table">
        <thead><tr><th>Parameter</th><th>Unit</th><th>Min &ndash; Max</th></tr></thead>
        <tbody>
          <% byStage[stage].forEach(function(p) { %>
            <tr>
              <td><%= p.label %></td>
              <td><%= p.unit %></td>
              <td class="range-inputs">
                <% if (can('manage_qc_settings')) { %>
                  <input form="qc-bulk" type="hidden" name="id" value="<%= p.id %>" />
                  <input form="qc-bulk" type="number" step="any" name="min_<%= p.id %>" value="<%= p.min_value === null ? '' : p.min_value %>" placeholder="min" />
                  <input form="qc-bulk" type="number" step="any" name="max_<%= p.id %>" value="<%= p.max_value === null ? '' : p.max_value %>" placeholder="max" />
                <% } else { %>
                  <%= p.min_value === null ? '–' : p.min_value %> &ndash; <%= p.max_value === null ? '–' : p.max_value %>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% }) %>

<% if (can('manage_qc_settings')) { %>
  <div class="card">
    <div class="form-actions"><button form="qc-bulk" class="btn" type="submit">Save all QC ranges</button></div>
  </div>
<% } %>

<%- include('partials/footer') %>
