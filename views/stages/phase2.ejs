<% var title = batch.batch_code + ' · Phase II' %>
<%- include('../partials/header') %>
<%- include('../partials/batch-banner') %>

<% var lastAdded = readings.reduce(function (a, r) { return !a || r.id > a.id ? r : a; }, null); %>
<%# On a phone the reading log moves above the summary (CSS order); desktop layout is unchanged. %>
<section class="card stage-card">
  <div class="stage-summary">
  <h2>Phase II &mdash; Pasteurization &amp; Conditioning (Tunnel)</h2>
  <form class="grid" method="post" action="/batches/<%= batch.id %>/phase2">
    <div class="field"><label>Tunnel ID</label><select name="tunnel_id"><%- optionsFor(tunnels, row.tunnel_id) %></select></div>
    <div class="field">
      <label>Fill Date (In)</label>
      <input type="date" name="fill_date" value="<%= v(row.fill_date) %>" />
    </div>
    <div class="field">
      <label>End Date (Out)</label>
      <input type="date" name="end_date" value="<%= v(row.end_date) %>" />
    </div>
    <div class="field">
      <label>Days</label>
      <input type="text" value="<%= daysText(row.fill_date, row.end_date) %>" disabled />
    </div>
    <div class="field"><label>Pasteurization Date</label><input type="date" name="pasteurization_date" value="<%= v(row.pasteurization_date) %>" /></div>

    <% if (dryMatterLoss && (dryMatterLoss.phase2 !== null || dryMatterLoss.total !== null)) { %>
      <div class="field wide">
        <div class="qc-legend">
          <% if (dryMatterLoss.phase2 !== null) { %>
            Dry matter lost in Phase II: <strong><%= dryMatterLoss.phase2.toFixed(1) %>%</strong>
            <span class="muted">(both measured)</span>
          <% } %>
          <% if (dryMatterLoss.phase2 !== null && dryMatterLoss.total !== null) { %>&nbsp;·&nbsp;<% } %>
          <% if (dryMatterLoss.total !== null) { %>
            Total since recipe: <strong><%= dryMatterLoss.total.toFixed(1) %>%</strong>
            <span class="muted">(from calculated recipe ash &mdash; indicative)</span>
          <% } %>
          <% if ((dryMatterLoss.phase2 !== null && dryMatterLoss.phase2 < 0) || (dryMatterLoss.total !== null && dryMatterLoss.total < 0)) { %>
            <br><span style="color:var(--red-600)">A negative loss is physically impossible &mdash; ash can't fall during composting. Check the sample or the entry.</span>
          <% } %>
        </div>
      </div>
    <% } %>
    <div class="field wide">
      <div class="qc-legend">
        The finished compost is sampled and checked as it leaves the tunnel, just before spawning:
        lab C:N, nitrogen and ash, final moisture, ammonia cleared, colour, texture and smell are all
        recorded on the <a href="/batches/<%= batch.id %>/spawning">Spawning page</a>.
      </div>
    </div>
    <div class="field wide"><label>Notes</label><textarea name="notes"><%= v(row.notes) %></textarea></div>
    <div class="form-actions">
      <button class="btn" type="submit">Save Phase II Summary</button>
      <label class="muted"><input type="checkbox" name="advance" value="1" style="width:auto" /> Mark Phase II complete &amp; move to Spawning</label>
    </div>
  </form>
  </div>

  <div class="stage-log">
  <div class="log-head">
  <h3 class="log-title">Conditioning Temperature / Ammonia Log</h3>
  <div class="qc-legend">Target conditioning temp: <%= qcParam('phase2','temp_c')?.min_value %>&ndash;<%= qcParam('phase2','temp_c')?.max_value %>°C · ammonia below <%= qcParam('phase2','ammonia_ppm')?.max_value %>ppm before spawning</div>
  </div>

  <div class="log-history">
  <% if (readings.length) { %>
    <div class="chart-wrap"><%- chart %></div>
    <table>
      <thead><tr><th>Date</th><th>Temp</th><th>Ammonia (ppm)</th><th>By</th><th>Notes</th><th></th></tr></thead>
      <tbody>
        <% readings.forEach(function(r) { %>
          <tr>
            <td><%= r.reading_date %></td>
            <td><%- qcCell('phase2','temp_c', r.temp_c) %></td>
            <td><%- qcCell('phase2','ammonia_ppm', r.ammonia_ppm) %></td>
            <td><%= v(r.entered_by) %></td>
            <td><%= v(r.notes) %></td>
            <td>
              <form method="post" action="/batches/<%= batch.id %>/phase2/readings/<%= r.id %>/delete" data-confirm="Delete this reading?">
                <button class="btn small danger" type="submit">Del</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <div class="empty-state">No readings logged yet.</div>
  <% } %>
  </div>

  <form id="add-reading" class="grid log-form" method="post" action="/batches/<%= batch.id %>/phase2/readings">
    <% if (saved && lastAdded) { %>
      <div class="field wide saved-notice">
        &#10003; Saved: <%= lastAdded.reading_date %><%= lastAdded.temp_c !== null ? ' · ' + lastAdded.temp_c + '°C' : '' %><%= lastAdded.ammonia_ppm !== null ? ' · ' + lastAdded.ammonia_ppm + ' ppm ammonia' : '' %>
      </div>
    <% } %>
    <div class="field"><label>Date</label><input type="date" name="reading_date" value="<%= today %>" /></div>
    <div class="field"><label>Temp (°C)</label><input type="number" step="any" name="temp_c" inputmode="decimal" /></div>
    <div class="field"><label>Ammonia (ppm)</label><input type="number" step="any" name="ammonia_ppm" inputmode="decimal" /></div>
    <div class="field"><label>Entered By</label><input type="text" name="entered_by" value="<%= currentUser.full_name || currentUser.username %>" /></div>
    <div class="field wide"><label>Notes</label><input type="text" name="notes" /></div>
    <div class="form-actions"><button class="btn" type="submit">Add Reading</button></div>
  </form>
  </div>
</section>

<%- include('../partials/footer') %>
