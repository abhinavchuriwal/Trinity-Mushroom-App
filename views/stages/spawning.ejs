<% var title = batch.batch_code + ' · Spawning' %>
<%- include('../partials/header') %>
<%- include('../partials/batch-banner') %>

<section class="card">
  <h2>Spawning</h2>
  <div class="qc-legend">Target compost temp at spawning: <%= qcParam('spawning','compost_temp_c')?.min_value %>&ndash;<%= qcParam('spawning','compost_temp_c')?.max_value %>°C · spawn rate <%= qcParam('spawning','spawn_rate_pct')?.min_value %>&ndash;<%= qcParam('spawning','spawn_rate_pct')?.max_value %>%</div>
  <form class="grid" method="post" action="/batches/<%= batch.id %>/spawning">
    <div class="field">
      <label>Spawning Date (In)</label>
      <input type="date" name="spawning_date" value="<%= v(row.spawning_date) %>" />
    </div>
    <div class="field">
      <label>Spawn Run End Date (Out)</label>
      <input type="date" name="spawn_run_end_date" value="<%= v(row.spawn_run_end_date) %>" />
    </div>
    <div class="field">
      <label>Days</label>
      <input type="text" value="<%= daysText(row.spawning_date, row.spawn_run_end_date) %>" disabled />
    </div>
    <div class="field"><label>Spawn Strain</label><input type="text" name="spawn_strain" value="<%= v(row.spawn_strain) %>" /></div>
    <div class="field">
      <label>Spawn Rate (%)</label>
      <input type="number" step="any" name="spawn_rate_pct" value="<%= v(row.spawn_rate_pct) %>" />
      <%- qcCell('spawning','spawn_rate_pct', row.spawn_rate_pct) %>
    </div>
    <div class="field">
      <label>Spawning Method</label>
      <select name="spawning_method">
        <option value="">—</option>
        <option value="surface" <%= row.spawning_method === 'surface' ? 'selected' : '' %>>Surface</option>
        <option value="through_mix" <%= row.spawning_method === 'through_mix' ? 'selected' : '' %>>Through-mix</option>
      </select>
    </div>
    <div class="field">
      <label>Compost Temp at Spawning (°C)</label>
      <input type="number" step="any" name="compost_temp_c" value="<%= v(row.compost_temp_c) %>" />
      <%- qcCell('spawning','compost_temp_c', row.compost_temp_c) %>
    </div>
    <div class="field"><label>Room</label><select name="room_id"><%- optionsFor(growingRooms, row.room_id) %></select></div>
    <div class="field"><label>No. of Bags</label><input type="number" id="num-bags" name="num_bags" value="<%= v(row.num_bags) %>" /></div>
    <div class="field"><label>Kg per Bag</label><input type="number" step="any" id="kg-per-bag" name="kg_per_bag" value="<%= v(row.kg_per_bag) %>" /></div>
    <div class="field">
      <label>Total Fill Weight (kg)</label>
      <input type="text" id="fill-weight-display" value="<%= row.fill_weight_kg !== null && row.fill_weight_kg !== undefined ? row.fill_weight_kg + ' kg' : '—' %>" disabled />
    </div>
    <div class="field"><label>Entered By</label><input type="text" name="entered_by" value="<%= v(row.entered_by) %>" /></div>

    <div class="field wide">
      <h3 style="margin:0.4rem 0 0">Finished Compost &mdash; Checked at Spawning</h3>
      <div class="qc-legend">
        The sample is taken as the compost leaves the tunnel, just before spawning. Ammonia
        clearance is the go/no-go signal &mdash; compost still smelling of ammonia will hold the
        spawn back. All of this goes onto the spec sheet the growing unit receives with the compost.
      </div>
    </div>
    <div class="field">
      <label>Lab C:N Ratio (measured)</label>
      <input type="number" step="any" name="final_cn_ratio" value="<%= v(finished.final_cn_ratio) %>" placeholder="e.g. 17.5" />
      <%- qcCell('phase2','final_cn_ratio', finished.final_cn_ratio) %>
    </div>
    <div class="field">
      <label>Lab Nitrogen % (dry basis)</label>
      <input type="number" step="any" name="final_nitrogen_pct" value="<%= v(finished.final_nitrogen_pct) %>" placeholder="e.g. 2.1" />
      <%- qcCell('phase2','final_nitrogen_pct', finished.final_nitrogen_pct) %>
    </div>
    <div class="field">
      <label>Lab Ash % (dry basis)</label>
      <input type="number" step="any" name="final_ash_pct" value="<%= v(finished.final_ash_pct) %>" />
      <%- qcCell('phase2','final_ash_pct', finished.final_ash_pct) %>
    </div>
    <div class="field">
      <label>Final Moisture (%)</label>
      <input type="number" step="any" name="final_moisture_pct" value="<%= v(finished.final_moisture_pct) %>" />
      <%- qcCell('phase2','final_moisture_pct', finished.final_moisture_pct) %>
    </div>
    <div class="field">
      <label>Ammonia Cleared?</label>
      <select name="ammonia_cleared">
        <option value="" <%= !finished.ammonia_cleared ? 'selected' : '' %>>—</option>
        <option value="yes" <%= finished.ammonia_cleared === 'yes' ? 'selected' : '' %>>Yes</option>
        <option value="no" <%= finished.ammonia_cleared === 'no' ? 'selected' : '' %>>No</option>
      </select>
    </div>
    <div class="field"><label>Compost Color</label><input type="text" name="compost_color" value="<%= v(finished.compost_color) %>" placeholder="e.g. dark brown" /></div>
    <div class="field"><label>Compost Texture</label><input type="text" name="compost_texture" value="<%= v(finished.compost_texture) %>" placeholder="e.g. friable, springy" /></div>
    <div class="field"><label>Compost Smell</label><input type="text" name="compost_smell" value="<%= v(finished.compost_smell) %>" placeholder="e.g. sweet, no ammonia" /></div>

    <div class="field wide"><label>Notes</label><textarea name="notes"><%= v(row.notes) %></textarea></div>
    <div class="form-actions">
      <button class="btn" type="submit">Save Spawning Data</button>
      <label class="muted"><input type="checkbox" name="advance" value="1" style="width:auto" /> Mark spawning complete &amp; move to <%= nextStageLabel(batch, 'spawning') %></label>
    </div>
  </form>
</section>

<script>
  (function () {
    var bagsEl = document.getElementById('num-bags');
    var kgEl = document.getElementById('kg-per-bag');
    var display = document.getElementById('fill-weight-display');
    function recalc() {
      var bags = parseFloat(bagsEl.value);
      var kg = parseFloat(kgEl.value);
      display.value = (bags && kg) ? (bags * kg).toLocaleString('en-IN') + ' kg' : '—';
    }
    bagsEl.addEventListener('input', recalc);
    kgEl.addEventListener('input', recalc);
  })();
</script>

<%- include('../partials/footer') %>
