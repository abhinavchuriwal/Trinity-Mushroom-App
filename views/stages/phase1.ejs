<% var title = batch.batch_code + ' · Phase I' %>
<%- include('../partials/header') %>
<%- include('../partials/batch-banner') %>

<%
  // Supervisors on a phone come here to add a turn reading, so the reading form
  // is pre-filled with what's almost always right (today, the next turn, this
  // batch's bunker, their own name) — they only type the measurements.
  var nextTurn = readings.reduce(function (m, r) { return Math.max(m, r.turn_number || 0); }, 0) + 1;
  var lastAdded = readings.reduce(function (a, r) { return !a || r.id > a.id ? r : a; }, null);
%>
<%# On a phone the turn log moves above the summary (CSS order); desktop layout is unchanged. %>
<section class="card stage-card">
  <div class="stage-summary">
  <h2>Phase I Composting (Bunker)</h2>
  <form class="grid" method="post" action="/batches/<%= batch.id %>/phase1">
    <div class="field">
      <label>Start Date (In)</label>
      <input type="date" name="start_date" value="<%= v(row.start_date) %>" />
    </div>
    <div class="field">
      <label>End Date (Out)</label>
      <input type="date" name="end_date" value="<%= v(row.end_date) %>" />
    </div>
    <div class="field">
      <label>Days</label>
      <input type="text" value="<%= daysLabel(days) %>" disabled />
    </div>
    <div class="field">
      <label>Bunker No.</label>
      <select name="bunker_no"><%- optionsFor(bunkers, row.bunker_no) %></select>
    </div>
    <div class="field">
      <label>Planned Turns</label>
      <input type="number" name="num_turns_planned" value="<%= v(row.num_turns_planned) %>" />
    </div>

    <div class="field wide">
      <h3 style="margin:0.4rem 0 0">Lab Analysis &mdash; End of Phase I</h3>
      <div class="qc-legend">Measured from a sample of the compost as it leaves the bunker, not calculated. Leave blank until results come back from the lab.</div>
    </div>
    <div class="field">
      <label>C:N Ratio (measured)</label>
      <input type="number" step="any" name="end_cn_ratio" value="<%= v(row.end_cn_ratio) %>" placeholder="e.g. 21" />
      <%- qcCell('phase1','end_cn_ratio', row.end_cn_ratio) %>
    </div>
    <div class="field">
      <label>Nitrogen % (dry basis)</label>
      <input type="number" step="any" name="end_nitrogen_pct" value="<%= v(row.end_nitrogen_pct) %>" />
      <%- qcCell('phase1','end_nitrogen_pct', row.end_nitrogen_pct) %>
    </div>
    <div class="field">
      <label>Ash % (dry basis)</label>
      <input type="number" step="any" name="end_ash_pct" value="<%= v(row.end_ash_pct) %>" />
      <%- qcCell('phase1','end_ash_pct', row.end_ash_pct) %>
    </div>
    <% if (dryMatterLoss && dryMatterLoss.phase1 !== null) { %>
      <div class="field">
        <label>Dry matter lost in Phase I</label>
        <input type="text" value="<%= dryMatterLoss.phase1.toFixed(1) %>%" disabled />
        <span class="muted" style="font-size:0.78rem">From recipe ash (calculated) to this ash (measured) &mdash; indicative<%= dryMatterLoss.phase1 < 0 ? '. Negative is impossible — check the sample or entry.' : '' %></span>
      </div>
    <% } %>

    <div class="field wide">
      <label>Notes</label>
      <textarea name="notes"><%= v(row.notes) %></textarea>
    </div>
    <div class="form-actions">
      <button class="btn" type="submit">Save Phase I Summary</button>
      <label class="muted"><input type="checkbox" name="advance" value="1" style="width:auto" /> Mark Phase I complete &amp; move to Phase II</label>
    </div>
  </form>
  </div>

  <div class="stage-log">
  <div class="log-head">
  <h3 class="log-title">Turn Log</h3>
  <p class="muted">Readings are captured before each turn.</p>
  <div class="qc-legend">Target compost temp: <%= qcParam('phase1','pile_temp_c')?.min_value %>&ndash;<%= qcParam('phase1','pile_temp_c')?.max_value %>°C · moisture <%= qcParam('phase1','moisture_pct')?.min_value %>&ndash;<%= qcParam('phase1','moisture_pct')?.max_value %>% · pH <%= qcParam('phase1','ph')?.min_value %>&ndash;<%= qcParam('phase1','ph')?.max_value %></div>
  </div>

  <div class="log-history">
  <% if (readings.length) { %>
    <div class="chart-wrap"><%- chart %></div>
    <table>
      <thead>
        <tr><th>Turn</th><th>Date</th><th>Bunker</th><th>Compost Temp</th><th>Ambient</th><th>Moisture</th><th>Ammonia</th><th>pH</th><th>By</th><th>Notes</th><th></th></tr>
      </thead>
      <tbody>
        <% readings.forEach(function(r) { %>
          <tr>
            <td><%= v(r.turn_number) %></td>
            <td><%= r.reading_date %></td>
            <td><%= v(r.bunker_no) %></td>
            <td><%- qcCell('phase1','pile_temp_c', r.pile_temp_c) %></td>
            <td><%= v(r.ambient_temp_c) %></td>
            <td><%- qcCell('phase1','moisture_pct', r.moisture_pct) %></td>
            <td><%= v(r.ammonia_level) %></td>
            <td><%- qcCell('phase1','ph', r.ph) %></td>
            <td><%= v(r.entered_by) %></td>
            <td><%= v(r.notes) %></td>
            <td>
              <form method="post" action="/batches/<%= batch.id %>/phase1/readings/<%= r.id %>/delete" data-confirm="Delete this reading?">
                <button class="btn small danger" type="submit">Del</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <div class="empty-state">No readings logged yet.</div>
  <% } %>
  </div>

  <form id="add-reading" class="grid log-form" method="post" action="/batches/<%= batch.id %>/phase1/readings">
    <% if (saved && lastAdded) { %>
      <div class="field wide saved-notice">
        &#10003; Saved: <%= lastAdded.turn_number ? 'Turn ' + lastAdded.turn_number + ', ' : '' %><%= lastAdded.reading_date %><%= lastAdded.pile_temp_c !== null ? ' · ' + lastAdded.pile_temp_c + '°C' : '' %><%= lastAdded.moisture_pct !== null ? ' · ' + lastAdded.moisture_pct + '% moisture' : '' %>
      </div>
    <% } %>
    <div class="field"><label>Turn #</label><input type="number" name="turn_number" value="<%= nextTurn %>" inputmode="numeric" /></div>
    <div class="field"><label>Date</label><input type="date" name="reading_date" value="<%= today %>" /></div>
    <div class="field"><label>Bunker No.</label><select name="bunker_no"><%- optionsFor(bunkers, row.bunker_no) %></select></div>
    <div class="field"><label>Compost Temp (°C)</label><input type="number" step="any" name="pile_temp_c" inputmode="decimal" /></div>
    <div class="field"><label>Ambient Temp (°C)</label><input type="number" step="any" name="ambient_temp_c" inputmode="decimal" /></div>
    <div class="field"><label>Moisture (%)</label><input type="number" step="any" name="moisture_pct" inputmode="decimal" /></div>
    <div class="field">
      <label>Ammonia</label>
      <select name="ammonia_level">
        <option value="">—</option>
        <option value="none">None</option>
        <option value="mild">Mild</option>
        <option value="strong">Strong</option>
      </select>
    </div>
    <div class="field"><label>pH</label><input type="number" step="any" name="ph" inputmode="decimal" /></div>
    <div class="field"><label>Entered By</label><input type="text" name="entered_by" value="<%= currentUser.full_name || currentUser.username %>" /></div>
    <div class="field wide"><label>Notes</label><input type="text" name="notes" /></div>
    <div class="form-actions"><button class="btn" type="submit">Add Reading</button></div>
  </form>
  </div>
</section>

<%- include('../partials/footer') %>
